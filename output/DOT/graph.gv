digraph Door {
 rankdir = LR;
 node [shape = circle;];
 null [shape = point;];
null -> A;
A -> B [label="AUTO(1 > 10)"];
A -> B [label="start(2 == 2)"];
A -> D [label="loop"];
B -> C [label="AUTO(counter == 0)"];
C -> A [label="AUTO"];
C -> B [label="AUTO"];
C -> A [label="reset"];
D -> D [label="AUTO"];
C [shape = doublecircle;];
}