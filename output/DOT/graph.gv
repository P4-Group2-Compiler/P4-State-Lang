digraph Football {
 rankdir = LR;
 node [shape = circle;];
 null [shape = point;];
null -> Playing;
Playing -> Warning [label="Tackle(yellow_cards < 1)"];
Playing -> RedCard [label="Tackle(yellow_cards >= 1)"];
Playing -> Warning [label="Hands(yellow_cards < 1)"];
Playing -> RedCard [label="Hands(yellow_cards >= 1)"];
Playing -> Tired [label="Sprint(stamina > 20)"];
Playing -> Injured [label="Injury"];
Warning -> Playing [label="PlayOn"];
Warning -> Suspended [label="Argue"];
Tired -> Playing [label="Rest"];
Tired -> Tired [label="Sprint(stamina > 20)"];
Tired -> Injured [label="Injury"];
Injured -> Bench [label="Recover"];
Bench -> Playing [label="Substitute"];
Suspended -> Bench [label="Appeal"];
RedCard [shape = doublecircle;];
}