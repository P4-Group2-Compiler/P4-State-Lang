digraph Football {
 rankdir = LR;
 node [shape = circle;];
 null [shape = point;];
null -> Player;
Player -> YellowCard [label="Tackle(x < 1)"];
Player -> RedCard [label="Tackle(x >= 1)"];
Player -> YellowCard [label="Hands(x < 1)"];
Player -> RedCard [label="Hands(x >= 1)"];
YellowCard -> Player [label="PlayOn"];
RedCard [shape = doublecircle;];
}