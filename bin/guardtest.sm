Statemachine M {
   # VAR x = 10
   # VAR y = 4
   # VAR amount_of_shots = 13
   // This is a single line comment
   Start State Open {
    ON Push IF x < 4  GO Closed
   }

   Final State Closed {
   (* This is a block comment 
   With two lines. *)
    ON Pull IF y + 4 >= x GO Open
    ON TEST GO SOMETHING
   }
}