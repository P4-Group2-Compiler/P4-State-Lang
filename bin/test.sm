Statemachine M {
   // this is a single line comment
   Start State Silke {
    ON Push GO Closed
   }

   State Closed {
      ON Kick GO Broken
   }

   State Broken {
      ON Hammer GO Destroyed
   }
   (*This should not throw an error *)
   Final State Destroyed {
    ON Pull GO Open
    ON TEST GO SOMETHING
   }
}