Statemachine Door {
  Start State Open {
    ON Push IF 3 + 4  GO Open
    ON Push IF 3 - 4  GO Open
    ON Push IF 3 * 4  GO Open
    ON Push IF 3 / 4  GO Open
    ON Push IF 3 % 4  GO Open
    ON Push IF 3 == 4  GO Open
    ON Push IF 3 != 4  GO Open
    ON Push IF 3 < 4  GO Open
    ON Push IF 3 <= 4  GO Open
    ON Push IF 3 > 4  GO Open
    ON Push IF 3 >= 4  GO Open
    ON Push IF 3 AND 4  GO Open
    ON Push IF 3 OR 4  GO Open
	  
    ON lock GO Locked
  }

  State Open {
	  ON pull GO Closed
  }

  Final State Locked {
	  ON unlock GO Closed
  }
}