Statemachine M {
   // This is a single line comment
   Start State A {
    ON Push GO Closed
   }

   Final State Closed {
   (* This is a block comment 
   With two lines. *)
    ON Pull GO Open
    ON Pull GO Closed
    ON Beer GO Party
    ON Whiskey GO Wrecked
   }

      Final State  Wrecked{
   (* This is a block comment 
   With two lines. *)
    ON Tequila GO Broke
    ON Wine GO Smashed
   }
}