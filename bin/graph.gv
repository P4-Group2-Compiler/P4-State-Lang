digraph Door {
 rankdir = LR;
 node [shape = circle;];
 null [shape = point;];
null -> Closed;
Closed -> Closed [label="nothing"];
Closed -> Open [label="push"];
Closed -> Open [label="kick"];
Closed -> Open [label="knock"];
Closed -> Locked [label="lock"];
Open -> Closed [label="pull"];
Open -> Closed [label="slam"];
Locked -> Closed [label="unlock"];
Locked [shape = doublecircle;];
}