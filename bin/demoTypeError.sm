Statemachine TypeError {

    #VAR x = 0

    Start State A {
        ON 1 IF 0 < 1 AND 1 < 1 GO B (* <---- AND expects BOOL *)
    }

    Final State B {
        ON 0 IF x < 0 GO A (* <--- x not declared as #VAR *)
    }

    State C {
        ON 1 IF (x < 0) + 1 GO C (* <---- Arithmetic operations *)
    }

    State D {
        ON 0 IF 1 GO C (* <---- Guard needs bool, not int *)
    }
}