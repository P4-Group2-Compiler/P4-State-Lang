Statemachine SyntaxError {
    #VAR x = 3
    #VAR y = 20
    #VAR CountdownToSemesterEnd_Days = 2

    INPUT 0 0 1 1 0 2 1

    State A { (* No start state *)
        ON 0 GO B
    }

    State B {
        ON 1 IF age > 4 AND x > 2 GO C { (* <--- iF *) (* C not declared *)
            DO age = age + 1
        }
    }

    state B { (* <--- state *) (* B declared twice *)
        ON 1 GO A
        ON 0 GO E
        ON 2 GO F
    }

    State !E { (* <--- !E *)
        AUTO GO C {
            DO CountdownToSemesterEnd_Days = x
        }
    }

    Final State F {
    }
}