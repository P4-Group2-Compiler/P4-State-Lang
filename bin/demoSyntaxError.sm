Statemachine SyntaxError {
    #VAR x = 3
    #VAR age = 20
    #VAR CountdownToSemesterEnd_Days = 2

    INPUT 0 0 1 1 0 2 1

    StartFinal State A {
        ON 0 GO B
    }

    State B {
        ON 1 iF x < 4 GO C {
            DO y = y + 1
        }
    }

    state C {
        ON 1 GO A
        ON 2 GO D
        ON 0 GO E
    }

    State !D {
        AUTO GO C {
            DO CountdownToSemesterEnds_Days = x
        }
    }

    Final State E {
    }
}