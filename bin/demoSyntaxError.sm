Statemachine SyntaxError {
    #VAR x = 3
    #VAR age = 20
    #VAR CountdownToSemesterEnd_Days = 2

    INPUT 0 0 1 1 0 2 1

    StartFinal State A {
        ON 0 GO B
    }

    State B {
        ON 1 iF x < 4 GO C { (* <--- iF *)
            DO age = age + 1
        }
    }

    state C { (* <--- state *)
        ON 1 GO A
        ON 2 GO D
        ON 0 GO E
    }

    State !D { (* <--- !D *)
        AUTO GO C {
            DO CountdownToSemesterEnd_Days = x
        }
    }

    Final State E {
    }
}